#!/usr/bin/env python3
"""dls: ls with drag and drop straight from the terminal.

Usage:  dls [ls flags] [paths...]
        dls -lh ~/Downloads

Hover a file in the listing: its name is highlighted and the cursor turns into a hand.
  drag over the names        -> selects (like selecting text); leaving the names
                                column sideways turns it into a drag of the selection
  drag a selected file       -> drags the whole selection
  click / shift / ctrl       -> selects one / a range / adds or removes
  a                          -> selects all; Esc clears the selection
  double click               -> opens with the default app
  right click                -> "open with..." menu
  wheel / arrows / PgUp PgDn -> scrolls the list (Home/End: top/bottom)
  Ctrl+Z                     -> suspends, like any program (fg brings it back)
  q / Esc / Ctrl+C           -> quits (the listing stays in the terminal, like ls)

While open it takes the whole terminal (like less): the terminal never scrolls
the list on its own, so the highlight is never over the wrong file.

How it works: the terminal reports which cell the mouse is over (mouse
tracking); a transparent window is placed exactly over that name and that
window gets the click, so the drag is native (XDND) and never goes through the
terminal.

No extra dependencies: python3 + GTK3 (already there on GNOME).
Requires X11 and gnome-terminal (the cell size comes from the profile font).
"""
import codecs
import itertools
import os
import re
import select
import signal
import subprocess
import sys
import termios
import tty
import unicodedata

# (gesture, action, priority): on a narrow terminal the highest numbers go first
HINTS = [("arraste pro lado", "envia", 0), ("arraste pra baixo", "seleciona", 1),
         ("ctrl/shift+clique", "vários", 4), ("2 cliques", "abre", 3), ("q", "sai", 2)]
MISALIGNED = ("  \x1b[33mdestaque desalinhado: volte o zoom do terminal (Ctrl+0)"
              " ou use o perfil padrão\x1b[0m")
MOUSE = re.compile(rb"\x1b\[<(\d+);(\d+);(\d+)([Mm])")
PARTIAL = re.compile(rb"\x1b(\[(<[\d;]*)?)?\Z")  # start of a mouse sequence at the end
# arrows, Home/End and PgUp/PgDn, with or without a modifier (on the full screen
# even Shift+PgUp comes to dls instead of scrolling the terminal)
NAV = re.compile(rb"\x1b\[(?:1;\d+)?([ABHF])|\x1b\[([56])(?:;\d+)?~")
# colors (SGR) and links (OSC 8, from --hyperlink): neither takes up a cell
ANSI = re.compile(r"\x1b\[[\d;]*m|\x1b\]8;[^\a\x1b]*(?:\a|\x1b\\)")
# full screen (no scrollback: the terminal never moves the list behind dls's
# back), no cursor, no line wrap (1 file = 1 screen line); then every mouse
# movement, in SGR format, and focus reports (\e[I / \e[O)
ENTER = b"\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[?1003h\x1b[?1006h\x1b[?1004h"
LEAVE = b"\x1b[?1003l\x1b[?1006l\x1b[?1004l\x1b[?7h\x1b[?25h\x1b[?1049l"
# ls flags that take an argument; the short ones become long so that an empty
# argument (-I '') can't swallow the flag after it
SHORT_ARG = {"I": "--ignore=", "T": "--tabsize=", "w": "--width="}
LONG_ARG = ("--block-size", "--format", "--hide", "--ignore", "--indicator-style",
            "--quoting-style", "--sort", "--tabsize", "--time", "--time-style", "--width")


def hint(cols):
    """Help line under the list: gesture in bold, action dimmed."""
    parts = list(HINTS)
    while len("   ".join(f"{g}: {a}" for g, a, _ in parts)) + 2 > cols and len(parts) > 1:
        parts.remove(max(parts, key=lambda h: h[2]))
    return "  " + "   ".join(f"\x1b[1m{g}\x1b[0;2m: {a}\x1b[0m" for g, a, _ in parts)


def cells(line):
    """Width in cells of a colored line: CJK and emoji take 2."""
    return sum(0 if unicodedata.combining(c) else
               2 if unicodedata.east_asian_width(c) in ("W", "F") else 1
               for c in ANSI.sub("", line))


def split_args(args):
    """(flags, paths) as ls reads them; each flag on its own, with its argument."""
    flags, paths, it = [], [], iter(args)
    for a in it:
        if a == "--":
            paths += it
        elif a.startswith("--"):
            # --hide X works without "=", and so does any prefix ls accepts (--hid X)
            if "=" not in a and any(n.startswith(a) for n in LONG_ARG):
                a += "=" + next(it, "")
            flags.append(a)
        elif a.startswith("-") and a != "-":
            for k, c in enumerate(a[1:], 2):  # grouped flags: -la, -lI*.o
                if c in SHORT_ARG:
                    flags.append(SHORT_ARG[c] + (a[k:] or next(it, "")))
                    break
                flags.append("-" + c)
        else:
            paths.append(a)
    return flags, paths


def ls_format(flags):
    """(format, classify): the layout ls ends up using and whether -F is on."""
    fmt, classify = "vertical", False  # on a terminal ls defaults to columns (-C)
    for f in flags:
        k, _, v = f.partition("=")
        if k in ("-l", "-g", "-o", "-n", "--full-time"):
            fmt = "long"
        elif k == "-1" and fmt != "long":  # -1 does nothing after -l
            fmt = "single-column"
        elif k in ("-C", "-x", "-m"):
            fmt = {"-C": "vertical", "-x": "across", "-m": "commas"}[k]
        elif k == "-f" and fmt == "long":  # -f turns -l off
            fmt = "vertical"
        elif k == "--format":
            fmt = {"verbose": "long", "horizontal": "across", "many-per-line": "vertical"}.get(v, v)
        elif k in ("-F", "--classify"):
            classify = v not in ("never", "no", "none")
        elif k in ("-p", "--file-type", "--indicator-style"):
            classify = v == "classify"
    return fmt, classify


def unquote(q):
    """Name from ls --quoting-style=c ("a\\nb" -> a, newline, b), invalid bytes included."""
    return os.fsdecode(codecs.escape_decode(q[1:-1])[0])


def parse(args):
    """(flags, files ls would list as absolute paths, format); files is None if ls fails.

    ls itself picks the files and their order, so every filter and sort flag
    (-a, -I, --hide, -R, -t, -U...) works like in ls.
    """
    flags, paths = split_args(args)
    fmt, classify = ls_format(flags)
    # only the names: -s, -i and -Z would print something before each one
    keep = [f for f in flags if f not in ("-s", "-i", "-Z", "-D") and f.split("=")[0]
            not in ("--size", "--inode", "--context", "--dired", "--zero")]
    if fmt == "long" and not any(f in ("-t", "-S", "-U", "-X", "-v", "-f")
                                 or f.startswith("--sort") for f in flags):
        # with -l, -c/-u only pick the time shown; without -l they'd also sort by it
        keep = [f for f in keep if f not in ("-c", "-u") and not f.startswith("--time=")]
    r = subprocess.run(
        # one name per line, C-quoted: a name with "\n" stays on one line
        ["ls", *keep, "--format=single-column", "--quoting-style=c", "--color=never",
         "--hyperlink=never",
         # with -l or -F, ls lists a symlink to a folder itself, not what's in it
         "--indicator-style=" + ("classify" if fmt == "long" or classify else "none"),
         # one more argument that isn't a folder makes ls name every folder it lists
         "--", *(paths or ["."]), "/dev/null"], capture_output=True)
    if r.returncode:
        return flags, None, fmt
    files, d = [], ""
    for line in r.stdout.split(b"\n"):
        if line.endswith(b'":'):  # a folder's header: "dir":
            d = unquote(line[:-1])
        elif line.startswith(b'"') and line != b'"/dev/null"':
            # the -F indicator (/ * @ | =) comes after the closing quote
            name = unquote(line[:line.rindex(b'"') + 1])
            files.append(os.path.join(os.path.abspath(d), name))  # keeps "." and ".."
    return flags, files, fmt


def render(flags, files):
    """One line per file, in the order of files, with the ls colors and format."""
    # -U keeps the order of files, which already is the ls order (parse).
    # With its output captured ls stops quoting and escaping names like it does
    # on a terminal; -q and QUOTING_STYLE bring that back ("\n" in a name would be 2 lines)
    env = {"QUOTING_STYLE": "shell-escape", **os.environ}
    colors = [f.partition("=")[2] for f in flags if f.startswith("--color")]
    color = "never" if colors and colors[-1] in ("never", "no", "none") else "always"
    lines = []
    for d, group in itertools.groupby(files, os.path.dirname):
        names = [os.path.basename(f) for f in group]
        # runs in the file's folder so ls shows just the name
        out = subprocess.run(
            ["ls", "-q", *flags, "-1dU", "--color=" + color, "--", *names],
            cwd=d, env=env, capture_output=True, text=True).stdout.splitlines()
        lines += out if len(out) == len(names) else names
    return lines


def columns(widths, cols, across=False):
    """Grid of ls -C (or -x): as many columns as fit, filled top to bottom (or across).

    Returns (rows, width of each column), with 2 spaces between columns.
    """
    n = len(widths)
    for k in range(min(n, max(cols // 3, 1)), 0, -1):
        rows = -(-n // k)
        w = ([max(widths[c::k]) for c in range(k)] if across else
             [max(widths[c:c + rows]) for c in range(0, n, rows)])
        if sum(w) + 2 * (len(w) - 1) < cols or len(w) == 1:
            return rows, w


def place(widths, cols, fmt):
    """Where ls puts each file: ([(row, screen column)], width of each highlight).

    The highlight is as wide as the file's column (a short name doesn't become a
    tiny target); with -m, as wide as the name.
    """
    n = len(widths)
    if fmt == "commas":  # "a, b, c": a new line when the next name doesn't fit
        pos, row, x = [], 0, 0
        for i, w in enumerate(widths):
            if i and x + w + 2 < cols:
                x += 2
            elif i:
                row, x = row + 1, 0
            pos.append((row, x))
            x += w
        return pos, [min(w, cols) for w in widths]
    if fmt in ("long", "single-column"):
        return [(i, 0) for i in range(n)], [min(max(widths), cols)] * n
    across = fmt == "across"
    rows, w = columns(widths, cols, across)
    w = [min(c, cols) for c in w]  # a single column wider than the screen: cut
    x = [sum(w[:c]) + 2 * c for c in range(len(w))]
    rc = [divmod(i, len(w)) if across else (i % rows, i // rows) for i in range(n)]
    return [(r, x[c]) for r, c in rc], [w[c] for _, c in rc]


class Axis:
    """Finds where the terminal grid starts on screen, along one axis.

    Each terminal event says "the mouse is in cell n" while the pointer is at p
    pixels; that limits the origin to an interval. Intersecting the intervals,
    the origin converges to the exact pixel within a few movements.

    An interval that's empty by a little is the pointer moving between the
    terminal's report and the reading: ignored. Empty by more than half a cell
    (misses) is an error that grows with every cell: the cell size is wrong
    (zoom, another profile).
    """

    def __init__(self, size):
        self.size, self.lo, self.hi, self.misses = size, None, None, 0

    def feed(self, cell, p):  # cell is 1-based
        lo, hi = p - cell * self.size + 1, p - (cell - 1) * self.size
        gap = 0 if self.lo is None else max(lo - self.hi, self.lo - hi)
        if self.lo is not None and gap <= 0:
            self.lo, self.hi = max(self.lo, lo), min(self.hi, hi)
        elif self.lo is None or gap > self.size // 2:
            self.misses += 0 < gap < self.size
            self.lo, self.hi = lo, hi  # 1st event or the window moved: start over

    def start(self, cell):
        return (self.lo + self.hi) // 2 + (cell - 1) * self.size

    def cell(self, p):
        return (p - (self.lo + self.hi) // 2) // self.size + 1


def gsetting(schema, key, path=None):
    """Reads a GSettings key; None if the schema doesn't exist (no GNOME)."""
    from gi.repository import Gio
    src = Gio.SettingsSchemaSource.get_default()
    if not src or not src.lookup(schema, True):
        return None  # Gio.Settings.new() with a missing schema aborts the process
    s = Gio.Settings.new_with_path(schema, path) if path else Gio.Settings.new(schema)
    return s.get_value(key).unpack()


def cell_size():
    """Size in pixels of a terminal cell, from the default profile's font."""
    from gi.repository import Gtk, Pango
    font = gsetting("org.gnome.desktop.interface", "monospace-font-name") or "Monospace 11"
    sw = sh = 1.0
    uid = gsetting("org.gnome.Terminal.ProfilesList", "default")
    if uid:
        path = f"/org/gnome/terminal/legacy/profiles:/:{uid}/"
        prof = lambda k: gsetting("org.gnome.Terminal.Legacy.Profile", k, path)
        if not prof("use-system-font"):
            font = prof("font")
        sw, sh = prof("cell-width-scale"), prof("cell-height-scale")
    # Simplification: reads the default profile's font, so zoom (Ctrl +) or another
    # profile misaligns (and dls warns). Read the current tab's profile if needed.
    # VTE measures the cell by the logical rectangle of one character, as Pango does
    layout = Gtk.Label().create_pango_layout("M")
    layout.set_font_description(Pango.FontDescription.from_string(font or "Monospace 11"))
    rect = layout.get_pixel_extents()[1]
    return round(rect.width * sw), round(rect.height * sh), layout.get_font_description()


def read_input(fd):
    """Reads what the terminal sent: ([(button, column, row)] of the mouse, keys).

    A read can cut a mouse sequence in half; while the end looks like the start
    of one, waits for the rest. That way Esc is only a key when it comes alone.
    """
    data = os.read(fd, 4096)
    while PARTIAL.search(data) and select.select([fd], [], [], 0.05)[0]:
        more = os.read(fd, 4096)
        if not more:
            break
        data += more
    events = [(int(b), int(col), int(row)) for b, col, row, _ in MOUSE.findall(data)]
    return events, MOUSE.sub(b"", data)


def missing_requirement():
    """Why dragging can't work in this session; None if it can."""
    if os.environ.get("XDG_SESSION_TYPE") == "wayland" or os.environ.get("WAYLAND_DISPLAY"):
        # Wayland doesn't let a window place itself or read the global pointer
        return "arrastar requer sessão X11; no Wayland use ripdrag ou dragon"
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("PangoCairo", "1.0")
        gi.require_foreign("cairo")
        from gi.repository import Gtk
    except (ImportError, ValueError):
        return "arrastar requer python3-gi, python3-gi-cairo e gir1.2-gtk-3.0"
    # a stale DISPLAY (old SSH session, tmux reattached from another machine):
    # without this check GTK aborts the process later, with the terminal in raw mode
    if not Gtk.init_check(None)[0]:
        return f"sem acesso ao display {os.environ.get('DISPLAY')}"
    return None


def run(files, lines, fd, fmt, cooked):
    from gi.repository import Gdk, Gio, GLib, Gtk, PangoCairo

    cw, ch, font = cell_size()
    ax, ay = Axis(cw), Axis(ch)
    gfiles = [Gio.File.new_for_path(f) for f in files]
    widths = [cells(l) for l in lines]
    # pos[i]: (row in the listing, screen column) of file i; hw[i]: width of its
    # highlight; grid: the files of each row, left to right; off: listing row at
    # the top of the screen; height: rows above the help line
    pos, hw, grid, off, height = [], [], [], 0, 0
    # i: file under the mouse; press: left button held (mode "band" selects by
    # dragging, "drag" will drag the selection); anchor: base of shift+click
    st = {"i": None, "dragging": False, "press": None, "anchor": None, "warned": False}
    sel = set()

    seat = Gdk.Display.get_default().get_default_seat()

    def pointer():
        _, x, y = seat.get_pointer().get_position()
        return x, y

    def shown(i):
        """Is file i on screen?"""
        return 0 <= i < len(lines) and off <= pos[i][0] < off + height

    def styled(i):
        """Line i as it goes on screen; selected = reverse video."""
        if i not in sel:
            return lines[i]
        return "\x1b[7m" + lines[i].replace("\x1b[0m", "\x1b[0;7m") + "\x1b[0m"

    def paint(i):
        if shown(i):
            r, x = pos[i]
            os.write(1, f"\x1b[{r - off + 1};{x + 1}H{styled(i)}".encode())

    def layout():
        """Lays the listing out for the current terminal size."""
        nonlocal pos, hw, grid, off, height
        cols, scr = os.get_terminal_size(fd)
        pos, hw = place(widths, cols, fmt)
        grid = [[] for _ in range(max(r for r, _ in pos) + 1)]
        for i, (r, _) in enumerate(pos):
            grid[r].append(i)
        height = max(min(len(grid), scr - 1), 0)
        off = min(off, len(grid) - height)

    # transparent window that covers the name under the mouse and gets the click
    win = Gtk.Window(type=Gtk.WindowType.POPUP)

    def redraw():
        """Draws the whole screen: the visible part of the listing and the help line."""
        out = "\x1b[H"
        for r in range(off, off + height):
            # each name at its column; with -m a comma after all but the last
            out += "\x1b[K" + "".join(
                f"\x1b[{pos[i][1] + 1}G{styled(i)}"
                + ("," if fmt == "commas" and i < len(lines) - 1 else "")
                for i in grid[r]) + "\r\n"
        tail = MISALIGNED if st["warned"] else hint(os.get_terminal_size(fd).columns)
        # no \n after the help line: on the last line it would scroll the screen
        os.write(1, (out + tail + "\x1b[K\x1b[J").encode())

    def scroll(n):
        """Scrolls the list n rows (n > 0 goes down)."""
        nonlocal off
        new = min(max(off + n, 0), len(grid) - height)
        if new != off:
            # the highlight stays put, over the file that scrolled under it (if any)
            i, j = st["i"], None
            if i is not None and pos[i][0] + new - off < len(grid):
                j = next((k for k in grid[pos[i][0] + new - off] if pos[k][1] == pos[i][1]),
                         None)
            off = new
            redraw()
            if j is not None:
                st["i"] = j
                win.queue_draw()
            else:
                hover(None)

    def select(new):
        changed = sel ^ set(new)
        sel.clear()
        sel.update(new)
        for i in changed:
            paint(i)

    def span(a, b):
        return range(min(a, b), max(a, b) + 1)

    win.set_visual(win.get_screen().get_rgba_visual())
    win.set_app_paintable(True)
    win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                   | Gdk.EventMask.BUTTON_MOTION_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK
                   | Gdk.EventMask.SCROLL_MASK)

    composited = win.get_screen().is_composited()
    plain = [ANSI.sub("", l) for l in lines]

    def draw(w, cr):
        if not composited:
            # no compositor, no transparency: draws the line itself over a
            # solid background, like a selection
            cr.set_source_rgb(0.16, 0.32, 0.62)
            cr.paint()
            layout = w.create_pango_layout(plain[st["i"]] if st["i"] is not None else "")
            layout.set_font_description(font)
            cr.set_source_rgb(1, 1, 1)
            PangoCairo.show_layout(cr, layout)
            return
        cr.set_source_rgba(0.35, 0.6, 1.0, 0.28)
        cr.paint()
        cr.set_source_rgba(0.35, 0.6, 1.0, 0.9)
        cr.rectangle(0.5, 0.5, w.get_allocated_width() - 1, w.get_allocated_height() - 1)
        cr.stroke()

    win.connect("draw", draw)
    win.connect("realize", lambda w: w.get_window().set_cursor(
        Gdk.Cursor.new_from_name(w.get_display(), "grab")))

    def hover(i):
        """Highlights file i; None hides it. Only the terminal knows which row is
        under the mouse: guessing by pixel would be wrong with a window over it."""
        if st["dragging"] or st["press"]:
            return
        if i is None or not shown(i) or ay.lo is None:
            st["i"] = None
            win.hide()
            return
        if i == st["i"] and win.get_visible():
            return  # same name: nothing to move
        st["i"] = i
        # move after show: while hidden, GTK3 ignores a move to the same place as
        # the 1st time it was shown, and the window would come back on the old row
        r, x = pos[i]
        win.resize(hw[i] * cw, ch)
        win.show()
        win.move(ax.start(x + 1), ay.start(r - off + 1))
        win.queue_draw()

    def unhover_if_away():
        """Hides the highlight if the pointer isn't over it anymore (button released
        or drag ended elsewhere); back on the terminal, the terminal shows it again."""
        x, y = pointer()
        (wx, wy), (w, h) = win.get_position(), win.get_size()
        if not (wx <= x < wx + w and wy <= y < wy + h):
            hover(None)

    def query(i, attr):
        """Gio.FileInfo of file i; None if it's gone or is a broken symlink."""
        try:
            return gfiles[i].query_info(attr, 0, None)
        except GLib.Error:
            return None

    def icon(i):
        info = query(i, "standard::icon")
        return info.get_icon() if info else Gio.ThemedIcon.new("text-x-generic")

    def drag_icon(ctx):
        """Icon of the 1st file; with several, a badge with how many."""
        first = min(sel)
        if len(sel) == 1:
            Gtk.drag_set_icon_gicon(ctx, icon(first), 0, 0)
            return
        import cairo
        info = Gtk.IconTheme.get_default().lookup_by_gicon(icon(first), 48, 0)
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 64, 64)
        cr = cairo.Context(surf)
        if info:
            Gdk.cairo_set_source_pixbuf(cr, info.load_icon(), 0, 16)
            cr.paint()
        cr.set_source_rgb(0.2, 0.45, 0.95)
        cr.arc(46, 18, 16, 0, 6.3)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(15)
        txt = str(len(sel))
        ext = cr.text_extents(txt)
        cr.move_to(46 - ext.width / 2 - ext.x_bearing, 18 + ext.height / 2)
        cr.show_text(txt)
        Gtk.drag_set_icon_surface(ctx, surf)

    targets = Gtk.TargetList.new([])
    targets.add_uri_targets(0)

    def begin_drag(e):
        st["press"] = None
        st["dragging"] = True
        win.drag_begin_with_coordinates(targets, Gdk.DragAction.COPY, 1, e, -1, -1)

    win.connect("drag-begin", lambda w, ctx: drag_icon(ctx))
    win.connect("drag-data-get", lambda w, ctx, data, info, t: data.set_uris(
        [gfiles[i].get_uri() for i in sorted(sel)]))

    def drag_end(*_):
        st["dragging"] = False
        unhover_if_away()

    win.connect("drag-end", drag_end)

    def launch(app, f):  # app None = the system default
        try:
            if app:
                app.launch([f], None)
            else:
                Gio.AppInfo.launch_default_for_uri(f.get_uri(), None)
        except GLib.Error:
            pass

    def press(w, e):
        i = st["i"]
        if e.button != 1 or i is None:
            return True
        if e.type == Gdk.EventType._2BUTTON_PRESS:
            launch(None, gfiles[i])
            return True
        if e.type != Gdk.EventType.BUTTON_PRESS:
            return True
        # collapse: releasing without dragging leaves only this one selected
        mode, collapse = None, False
        if e.state & Gdk.ModifierType.SHIFT_MASK and st["anchor"] is not None:
            select(span(st["anchor"], i))
        elif e.state & Gdk.ModifierType.CONTROL_MASK:
            select(sel ^ {i})
            st["anchor"] = i
            mode = "drag" if i in sel else None
        elif i in sel:
            mode, collapse = "drag", True
        else:
            select({i})
            st["anchor"] = i
            mode = "band"
        st["press"] = {"i": i, "x": e.x_root, "y": e.y_root, "mode": mode,
                       "collapse": collapse}
        return True

    def motion(w, e):
        p = st["press"]
        if not p or not p["mode"]:
            return True
        moved = w.drag_check_threshold(int(p["x"]), int(p["y"]), int(e.x_root), int(e.y_root))
        if p["mode"] == "band" and moved and not p.get("vertical"):
            # the 1st movement decides: more sideways = drag just this one,
            # more up/down = select like text
            if abs(e.x_root - p["x"]) > abs(e.y_root - p["y"]):
                p["mode"] = "drag"
            else:
                p["vertical"] = True
        a = st["anchor"]
        if p["mode"] == "drag":
            if moved:
                begin_drag(e)
        elif not p.get("vertical"):
            pass  # still within the threshold
        elif not (x0 := ax.start(pos[a][1] + 1)) <= e.x_root < x0 + hw[a] * cw:
            begin_drag(e)  # left the names column sideways: becomes a drag
        else:
            # button held: the terminal doesn't see the mouse, only the pixel tells
            # the row, kept within the rows on screen; selects the files of the
            # anchor's column from its row to that one
            r = min(max(ay.cell(int(e.y_root)) - 1 + off, off), off + height - 1)
            ra = pos[a][0]
            same = [k for row in grid[min(r, ra):max(r, ra) + 1] for k in row
                    if pos[k][1] == pos[a][1]]
            select(span(min(same), max(same)))
        return True

    win.connect("button-press-event", press)
    win.connect("motion-notify-event", motion)

    def release(w, e):
        p, st["press"] = st["press"], None
        if st["dragging"]:
            return True
        if e.button == 1 and p and p["collapse"]:
            select({p["i"]})
            st["anchor"] = p["i"]
        elif e.button == 3 and st["i"] is not None:
            f = gfiles[st["i"]]
            info = query(st["i"], "standard::content-type")
            ctype = info and info.get_content_type()
            menu = Gtk.Menu()
            for app in Gio.AppInfo.get_all_for_type(ctype) if ctype else []:
                item = Gtk.MenuItem(label=app.get_display_name())
                item.connect("activate", lambda _, a=app: launch(a, f))
                menu.append(item)
            if not menu.get_children():
                menu.append(Gtk.MenuItem(label="(nenhum app)", sensitive=False))
            menu.show_all()
            menu.popup_at_pointer(e)
            st["menu"] = menu  # keeps a reference while it's open
        unhover_if_away()
        return True

    win.connect("button-release-event", release)

    def leave(w, e):
        # left the name: hide; on the terminal the next movement shows the new one
        # (ignores leaving because of a grab: drag start, menu)
        if e.mode == Gdk.CrossingMode.NORMAL:
            hover(None)

    win.connect("leave-notify-event", leave)

    def wheel(w, e):
        # with the pointer over the highlight the wheel comes here, not to the terminal
        down = e.direction == Gdk.ScrollDirection.DOWN
        if down or e.direction == Gdk.ScrollDirection.UP:
            scroll(3 if down else -3)
        return True

    win.connect("scroll-event", wheel)

    def suspend():
        """Ctrl+Z: gives the terminal back to the shell and stops; fg resumes."""
        hover(None)
        try:
            os.write(1, LEAVE)
            termios.tcsetattr(fd, termios.TCSADRAIN, cooked)
            os.kill(0, signal.SIGTSTP)  # stops right here until fg
            tty.setraw(fd)
            os.write(1, ENTER)
        except (OSError, termios.error):
            Gtk.main_quit()  # the terminal is gone
            return
        resize()  # it may have changed size meanwhile

    def on_input(source, cond):
        events, keys = read_input(fd)
        if not events and not keys:
            Gtk.main_quit()  # terminal closed (EOF): quit instead of spinning
            return False
        if events:
            # wheel: button 64 up, 65 down (+4/8/16 with shift/alt/ctrl)
            scroll(sum(3 if b & 1 else -3 for b, _, _ in events if b & ~28 in (64, 65)))
            # the pointer read is the current one: only the newest event matches it
            _, col, row = events[-1]
            x, y = pointer()
            ax.feed(col, x)
            ay.feed(row, y)
            r = row - 1 + off  # cell (col, row) -> the file there, if any
            hover(next((i for i in grid[r] if pos[i][1] < col <= pos[i][1] + hw[i]), None)
                  if row <= height else None)
        page = max(height - 1, 1)
        for arrow, pg in NAV.findall(keys):
            scroll({b"A": -1, b"B": 1, b"H": -len(grid), b"F": len(grid),
                    b"5": -page, b"6": page}[arrow or pg])
        keys = NAV.sub(b"", keys)
        # Simplification: only the y axis warns; 8px cells on x mistake lag for zoom
        if not st["warned"] and ay.misses >= 3:
            st["warned"] = True
            redraw()  # the warning replaces the help line
        # tab switched or window unfocused: no movement comes to hide the highlight;
        # on a visible terminal the next movement shows it again. Without a window
        # manager (no active window) focus follows the pointer, and the highlight
        # taking it when it shows up is no reason to hide it.
        if b"\x1b[O" in keys and win.get_screen().get_active_window():
            hover(None)
        # whole keys only: pasted text with a q or an a in it does nothing
        keys = keys.replace(b"\x1b[O", b"").replace(b"\x1b[I", b"")
        if keys == b"\x1b" and sel:
            select(())  # Esc clears the selection; another Esc quits
        elif keys in (b"q", b"\x1b") or b"\x03" in keys:
            Gtk.main_quit()
            return False
        elif keys == b"a":
            select(range(len(files)))
        elif keys == b"\x1a":
            suspend()
        return True

    def resize():
        # zoom resizes too: measure again and redraw at the new size
        st["warned"], ay.misses = False, 0
        hover(None)
        layout()
        redraw()
        return True

    GLib.io_add_watch(fd, GLib.IO_IN, on_input)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGWINCH, resize)
    # killed by a signal (kill, tab closed): quits the normal way, restoring the terminal
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, lambda *_: Gtk.main_quit() or False)
    os.write(1, ENTER)
    layout()
    redraw()
    Gtk.main()


def main():
    args = sys.argv[1:]
    flags, files, fmt = parse(args)
    if files is None or "--help" in flags or "--version" in flags:
        return subprocess.call(["ls", *args])  # shows the ls error (or help)
    # output redirected (dls > x, dls | less): no terminal to draw on
    if not files or not (sys.stdin.isatty() and sys.stdout.isatty()) \
            or not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return subprocess.call(["ls", "--color=auto", *args])
    problem = missing_requirement()
    if problem:
        print(f"dls: {problem}", file=sys.stderr)
        return subprocess.call(["ls", "--color=auto", *args])

    lines = render(flags, files)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        run(files, lines, fd, fmt, old)
    finally:
        try:
            os.write(1, LEAVE)
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        except OSError:
            pass  # tab closed: no terminal left to restore
        else:
            # out of the full screen, the listing stays in the terminal: the one from ls
            subprocess.call(["ls", "--color=auto", *args])
    return 0


if __name__ == "__main__":
    sys.exit(main())
