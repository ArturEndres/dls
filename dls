#!/usr/bin/env python3
"""dls: ls com drag and drop direto do terminal.

Uso:  dls [flags do ls] [caminhos...]
      dls -lh ~/Downloads

Passe o mouse sobre um arquivo da lista: a linha destaca e o cursor vira mao.
  arrastar sobre os nomes  -> seleciona (como selecionar texto); saindo pro lado
                              da coluna dos nomes, vira arraste dos selecionados
  arrastar uma selecionada -> arrasta toda a selecao
  clique / shift / ctrl    -> seleciona um / intervalo / adiciona-remove
  a                        -> seleciona todos; Esc limpa a selecao
  duplo clique             -> abre com o app padrao
  clique direito           -> menu "abrir com..."
  roda / setas / PgUp PgDn -> rola a lista (Home/End: inicio/fim)
  q / Esc / Ctrl+C         -> sai (a lista fica no terminal, como no ls)

Enquanto aberto ocupa o terminal todo (como o less): assim o terminal nunca
rola a lista por conta propria e o destaque nunca fica sobre o arquivo errado.

Como funciona: o terminal informa em qual linha esta o mouse (mouse tracking);
uma janela transparente e colocada exatamente sobre essa linha e e ela que
recebe o clique, entao o arraste e nativo (XDND), sem passar pelo terminal.

Sem dependencias extras: python3 + GTK3 (ja presentes no GNOME).
Requer X11 e gnome-terminal (tamanho da celula vem da fonte do perfil).
"""
import itertools
import locale
import os
import re
import select
import signal
import subprocess
import sys
import termios
import tty
import unicodedata

# (gesto, acao, prioridade): em terminal estreito saem primeiro as de numero maior
HINTS = [("arraste pro lado", "envia", 0), ("arraste pra baixo", "seleciona", 1),
         ("ctrl/shift+clique", "vários", 4), ("2 cliques", "abre", 3), ("q", "sai", 2)]
MISALIGNED = ("  \x1b[33mdestaque desalinhado: volte o zoom do terminal (Ctrl+0)"
              " ou use o perfil padrão\x1b[0m")
MOUSE = re.compile(rb"\x1b\[<(\d+);(\d+);(\d+)([Mm])")
PARTIAL = re.compile(rb"\x1b(\[(<[\d;]*)?)?\Z")  # inicio de sequencia de mouse no fim
# setas, Home/End e PgUp/PgDn, com ou sem modificador (na tela cheia ate o
# Shift+PgUp vem pro dls em vez de rolar o terminal)
NAV = re.compile(rb"\x1b\[(?:1;\d+)?([ABHF])|\x1b\[([56])(?:;\d+)?~")
ANSI = re.compile(r"\x1b\[[\d;]*m")


def hint(cols):
    """Linha de ajuda sob a lista: gesto em negrito, acao apagada."""
    parts = list(HINTS)
    while len("   ".join(f"{g}: {a}" for g, a, _ in parts)) + 2 > cols and len(parts) > 1:
        parts.remove(max(parts, key=lambda h: h[2]))
    return "  " + "   ".join(f"\x1b[1m{g}\x1b[0;2m: {a}\x1b[0m" for g, a, _ in parts)


def cells(line):
    """Largura em celulas de uma linha colorida: CJK e emoji ocupam 2."""
    return sum(0 if unicodedata.combining(c) else
               2 if unicodedata.east_asian_width(c) in ("W", "F") else 1
               for c in ANSI.sub("", line))


def parse(args):
    """(flags do ls, arquivos que o ls listaria em caminho absoluto)."""
    flags, paths, hidden, dir_only, end = [], [], False, False, False
    for a in args:
        if end:
            paths.append(a)
        elif a == "--":
            end = True
        elif a in ("--all", "--almost-all"):
            hidden = True
            flags.append(a)
        elif a == "--directory":
            dir_only = True
        elif a.startswith("--"):
            flags.append(a)
        elif a.startswith("-") and len(a) > 1:
            # flags agrupadas (ex: -la, -ld)
            hidden |= "a" in a or "A" in a
            dir_only |= "d" in a
            flags.append(a)
        # ponytail: argumento de flag (-I '*.o', -w 80) cai aqui; ignorado se nao
        # existir como arquivo. Parsear cada flag do ls se der falso positivo.
        elif os.path.lexists(a):
            paths.append(a)

    try:
        locale.setlocale(locale.LC_COLLATE, "")  # mesma ordem do ls
    except locale.Error:
        pass  # locale invalido: o ls tambem cai na ordem C
    files = []
    for p in paths or ["."]:
        if os.path.isdir(p) and not dir_only:
            d = os.path.abspath(p)
            files += [os.path.join(d, n) for n in sorted(os.listdir(d), key=locale.strxfrm)
                      if hidden or not n.startswith(".")]
        else:
            files.append(os.path.abspath(p))
    return flags, files


def render(flags, files):
    """Uma linha por arquivo, na ordem de files, com cores e formato do ls."""
    # ponytail: -U mantem a ordem de files (alfabetica); flags de ordenacao
    # (-t, -S) sao ignoradas. Ordenar files em python se fizer falta.
    # com a saida capturada o ls deixa de citar e escapar nomes como faz no
    # terminal; -q e o QUOTING_STYLE devolvem isso (um "\n" no nome viraria 2 linhas)
    env = {"QUOTING_STYLE": "shell-escape", **os.environ}
    lines = []
    for d, group in itertools.groupby(files, os.path.dirname):
        names = [os.path.basename(f) for f in group]
        # roda na pasta do arquivo para o ls mostrar so o nome
        out = subprocess.run(
            ["ls", "-q", *flags, "-1dU", "--color=always", "--", *names],
            cwd=d, env=env, capture_output=True, text=True).stdout.splitlines()
        lines += out if len(out) == len(names) else names
    return lines


def one_per_line(flags):
    """O ls poe 1 arquivo por linha com -l (e parentes: -g -o -n) ou -1."""
    return any(f.split("=")[-1] in ("long", "verbose", "single-column") if f.startswith("--")
               else set(f[1:]) & set("l1gon") for f in flags)


def columns(widths, cols):
    """Grade do ls -C: o maximo de colunas que cabe, preenchidas de cima pra baixo.

    Devolve (linhas, largura de cada coluna); o arquivo i fica na linha i % linhas
    e na coluna i // linhas, com 2 espacos entre colunas.
    """
    n = len(widths)
    for k in range(min(n, max(cols // 3, 1)), 0, -1):
        rows = -(-n // k)
        w = [max(widths[c:c + rows]) for c in range(0, n, rows)]
        if sum(w) + 2 * (len(w) - 1) < cols or len(w) == 1:
            return rows, w


class Axis:
    """Descobre onde a grade do terminal comeca na tela, num eixo.

    Cada evento do terminal diz "o mouse esta na celula n" e o ponteiro esta
    em p pixels; isso limita a origem a um intervalo. Intersectando os
    intervalos a origem converge para o pixel exato em poucos movimentos.

    Intervalo vazio por pouco e o ponteiro que andou entre o terminal informar
    e a leitura: ignora. Por mais de meia celula (misses) e erro que se acumula
    a cada celula: o tamanho da celula esta errado (zoom, outro perfil).
    """

    def __init__(self, size):
        self.size, self.lo, self.hi, self.misses = size, None, None, 0

    def feed(self, cell, p):  # cell 1-based
        lo, hi = p - cell * self.size + 1, p - (cell - 1) * self.size
        gap = 0 if self.lo is None else max(lo - self.hi, self.lo - hi)
        if self.lo is not None and gap <= 0:
            self.lo, self.hi = max(self.lo, lo), min(self.hi, hi)
        elif self.lo is None or gap > self.size // 2:
            self.misses += 0 < gap < self.size
            self.lo, self.hi = lo, hi  # 1o evento ou janela moveu: recomeca

    def start(self, cell):
        return (self.lo + self.hi) // 2 + (cell - 1) * self.size

    def cell(self, p):
        return (p - (self.lo + self.hi) // 2) // self.size + 1


def gsetting(schema, key, path=None):
    """Le uma chave do GSettings; None se o schema nao existir (sem GNOME)."""
    from gi.repository import Gio
    src = Gio.SettingsSchemaSource.get_default()
    if not src or not src.lookup(schema, True):
        return None  # Gio.Settings.new() com schema ausente aborta o processo
    s = Gio.Settings.new_with_path(schema, path) if path else Gio.Settings.new(schema)
    return s.get_value(key).unpack()


def cell_size():
    """Tamanho em pixels da celula do terminal, pela fonte do perfil padrao."""
    from gi.repository import Gtk, Pango
    font = gsetting("org.gnome.desktop.interface", "monospace-font-name") or "Monospace 11"
    sw = sh = 1.0
    uid = gsetting("org.gnome.Terminal.ProfilesList", "default")
    if uid:
        path = f"/org/gnome/terminal/legacy/profiles:/:{uid}/"
        prof = lambda k: gsetting("org.gnome.Terminal.Legacy.Profile", k, path)
        if not prof("use-system-font"):
            font = prof("font")
        sw, sh = prof("cell-width-scale"), prof("cell-height-scale")
    # ponytail: le a fonte do perfil padrao; zoom (Ctrl +) ou outro perfil
    # desalinha. Ler o perfil da aba atual se precisar.
    # a VTE mede a celula pelo retangulo logico de um caractere: o mesmo da Pango
    layout = Gtk.Label().create_pango_layout("M")
    layout.set_font_description(Pango.FontDescription.from_string(font or "Monospace 11"))
    rect = layout.get_pixel_extents()[1]
    return round(rect.width * sw), round(rect.height * sh), layout.get_font_description()


def read_input(fd):
    """Le o que o terminal mandou: ([(botao, coluna, linha)] do mouse, teclas).

    Uma leitura pode cortar uma sequencia de mouse no meio; enquanto o fim for
    o comeco de uma, espera o resto. Assim um Esc so e tecla se vier sozinho.
    """
    data = os.read(fd, 4096)
    while PARTIAL.search(data) and select.select([fd], [], [], 0.05)[0]:
        more = os.read(fd, 4096)
        if not more:
            break
        data += more
    events = [(int(b), int(col), int(row)) for b, col, row, _ in MOUSE.findall(data)]
    return events, MOUSE.sub(b"", data)


def missing_requirement():
    """Por que o arraste nao funciona nesta sessao; None se funciona."""
    if os.environ.get("XDG_SESSION_TYPE") == "wayland" or os.environ.get("WAYLAND_DISPLAY"):
        # Wayland nao deixa posicionar janela nem ler o ponteiro global
        return 'arrastar requer sessão X11 (no login: "Ubuntu on Xorg")'
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("PangoCairo", "1.0")
        gi.require_foreign("cairo")
    except (ImportError, ValueError):
        return "arrastar requer python3-gi, python3-gi-cairo e gir1.2-gtk-3.0"
    return None


def run(files, lines, fd, single):
    from gi.repository import Gdk, Gio, GLib, Gtk, PangoCairo

    cw, ch, font = cell_size()
    ax, ay = Axis(cw), Axis(ch)
    gfiles = [Gio.File.new_for_path(f) for f in files]
    widths = [cells(l) for l in lines]
    # grade: o arquivo i fica na linha i % rows e na coluna i // rows, que comeca na
    # celula colx[c] e tem a largura do maior nome dela (nome curto nao vira alvo
    # minusculo); off: linha da grade no topo da tela; height: linhas acima da dica
    rows, colw, colx, off, height = len(lines), [], [], 0, 0
    # i: linha sob o mouse; press: botao esquerdo segurado (modo "band" seleciona
    # arrastando, "drag" vai arrastar a selecao); anchor: base do shift+clique
    st = {"i": None, "dragging": False, "press": None, "anchor": None, "warned": False}
    sel = set()

    seat = Gdk.Display.get_default().get_default_seat()

    def pointer():
        _, x, y = seat.get_pointer().get_position()
        return x, y

    def shown(i):
        """O arquivo i esta na tela?"""
        return 0 <= i < len(lines) and off <= i % rows < off + height

    def fmt(i):
        """Linha i como vai pra tela; selecionada = video invertido."""
        if i not in sel:
            return lines[i]
        return "\x1b[7m" + lines[i].replace("\x1b[0m", "\x1b[0;7m") + "\x1b[0m"

    def paint(i):
        if shown(i):
            os.write(1, f"\x1b[{i % rows - off + 1};{colx[i // rows] + 1}H{fmt(i)}".encode())

    def layout():
        """Monta a grade para o tamanho atual do terminal."""
        nonlocal rows, colw, colx, off, height
        cols, scr = os.get_terminal_size(fd)
        rows, colw = (len(lines), [max(widths)]) if single else columns(widths, cols)
        colw = [min(w, cols) for w in colw]  # 1 coluna mais larga que a tela: corta
        colx = [sum(colw[:c]) + 2 * c for c in range(len(colw))]
        height = max(min(rows, scr - 1), 0)
        off = min(off, rows - height)

    # janela transparente que cobre a linha sob o mouse e recebe o clique
    win = Gtk.Window(type=Gtk.WindowType.POPUP)

    def redraw():
        """Desenha a tela toda: o trecho visivel da grade e a dica embaixo."""
        out = "\x1b[H"
        for r in range(off, off + height):
            out += "  ".join(fmt(i) + " " * (colw[c] - widths[i])
                             for c, i in enumerate(range(r, len(lines), rows))) + "\x1b[K\r\n"
        tail = MISALIGNED if st["warned"] else hint(os.get_terminal_size(fd).columns)
        # sem \n depois da dica: na ultima linha ele rolaria a tela
        os.write(1, (out + tail + "\x1b[K\x1b[J").encode())

    def scroll(n):
        """Rola a lista n linhas (n > 0 desce)."""
        nonlocal off
        new = min(max(off + n, 0), rows - height)
        if new != off:
            # o destaque fica no lugar, sobre o arquivo que rolou pra la (se houver)
            i = None if st["i"] is None else st["i"] + new - off
            off = new
            redraw()
            if i is not None and i < len(lines):
                st["i"] = i
                win.queue_draw()
            else:
                hover(None)

    def select(new):
        changed = sel ^ set(new)
        sel.clear()
        sel.update(new)
        for i in changed:
            paint(i)

    def span(a, b):
        return range(min(a, b), max(a, b) + 1)

    win.set_visual(win.get_screen().get_rgba_visual())
    win.set_app_paintable(True)
    win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                   | Gdk.EventMask.BUTTON_MOTION_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK
                   | Gdk.EventMask.SCROLL_MASK)

    composited = win.get_screen().is_composited()
    plain = [ANSI.sub("", l) for l in lines]

    def draw(w, cr):
        if not composited:
            # sem compositor nao ha transparencia: desenha a propria linha
            # sobre fundo solido, como uma selecao
            cr.set_source_rgb(0.16, 0.32, 0.62)
            cr.paint()
            layout = w.create_pango_layout(plain[st["i"]] if st["i"] is not None else "")
            layout.set_font_description(font)
            cr.set_source_rgb(1, 1, 1)
            PangoCairo.show_layout(cr, layout)
            return
        cr.set_source_rgba(0.35, 0.6, 1.0, 0.28)
        cr.paint()
        cr.set_source_rgba(0.35, 0.6, 1.0, 0.9)
        cr.rectangle(0.5, 0.5, w.get_allocated_width() - 1, w.get_allocated_height() - 1)
        cr.stroke()

    win.connect("draw", draw)
    win.connect("realize", lambda w: w.get_window().set_cursor(
        Gdk.Cursor.new_from_name(w.get_display(), "grab")))

    def hover(i):
        """Destaca o arquivo i; None esconde. So o terminal diz qual linha esta sob
        o mouse: palpite por pixel erraria com outra janela por cima do terminal."""
        if st["dragging"] or st["press"]:
            return
        if i is None or not shown(i) or ay.lo is None:
            st["i"] = None
            win.hide()
            return
        if i == st["i"] and win.get_visible():
            return  # mesma linha: nada a mover
        st["i"] = i
        # move depois do show: com a janela oculta o GTK3 ignora o move quando
        # o destino repete o da 1a exibicao, e ela reapareceria na linha antiga
        c = i // rows
        win.resize(colw[c] * cw, ch)
        win.show()
        win.move(ax.start(colx[c] + 1), ay.start(i % rows - off + 1))
        win.queue_draw()

    def unhover_if_away():
        """Esconde o destaque se o ponteiro nao esta mais sobre ele (soltou o botao
        ou o arraste longe); a volta pro terminal faz o terminal mostrar de novo."""
        x, y = pointer()
        (wx, wy), (w, h) = win.get_position(), win.get_size()
        if not (wx <= x < wx + w and wy <= y < wy + h):
            hover(None)

    def query(i, attr):
        """Gio.FileInfo do arquivo i; None se sumiu ou e symlink quebrado."""
        try:
            return gfiles[i].query_info(attr, 0, None)
        except GLib.Error:
            return None

    def icon(i):
        info = query(i, "standard::icon")
        return info.get_icon() if info else Gio.ThemedIcon.new("text-x-generic")

    def drag_icon(ctx):
        """Icone do 1o arquivo; com varios, um selo com a quantidade."""
        first = min(sel)
        if len(sel) == 1:
            Gtk.drag_set_icon_gicon(ctx, icon(first), 0, 0)
            return
        import cairo
        info = Gtk.IconTheme.get_default().lookup_by_gicon(icon(first), 48, 0)
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 64, 64)
        cr = cairo.Context(surf)
        if info:
            Gdk.cairo_set_source_pixbuf(cr, info.load_icon(), 0, 16)
            cr.paint()
        cr.set_source_rgb(0.2, 0.45, 0.95)
        cr.arc(46, 18, 16, 0, 6.3)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.select_font_face("Sans", 0, 1)
        cr.set_font_size(15)
        txt = str(len(sel))
        ext = cr.text_extents(txt)
        cr.move_to(46 - ext.width / 2 - ext.x_bearing, 18 + ext.height / 2)
        cr.show_text(txt)
        Gtk.drag_set_icon_surface(ctx, surf)

    targets = Gtk.TargetList.new([])
    targets.add_uri_targets(0)

    def begin_drag(e):
        st["press"] = None
        st["dragging"] = True
        win.drag_begin_with_coordinates(targets, Gdk.DragAction.COPY, 1, e, -1, -1)

    win.connect("drag-begin", lambda w, ctx: drag_icon(ctx))
    win.connect("drag-data-get", lambda w, ctx, data, info, t: data.set_uris(
        [gfiles[i].get_uri() for i in sorted(sel)]))

    def drag_end(*_):
        st["dragging"] = False
        unhover_if_away()

    win.connect("drag-end", drag_end)

    def launch(app, f):  # app None = padrao do sistema
        try:
            if app:
                app.launch([f], None)
            else:
                Gio.AppInfo.launch_default_for_uri(f.get_uri(), None)
        except GLib.Error:
            pass

    def press(w, e):
        i = st["i"]
        if e.button != 1 or i is None:
            return True
        if e.type == Gdk.EventType._2BUTTON_PRESS:
            launch(None, gfiles[i])
            return True
        if e.type != Gdk.EventType.BUTTON_PRESS:
            return True
        # collapse: soltar sem arrastar deixa so esta linha selecionada
        mode, collapse = None, False
        if e.state & Gdk.ModifierType.SHIFT_MASK and st["anchor"] is not None:
            select(span(st["anchor"], i))
        elif e.state & Gdk.ModifierType.CONTROL_MASK:
            select(sel ^ {i})
            st["anchor"] = i
            mode = "drag" if i in sel else None
        elif i in sel:
            mode, collapse = "drag", True
        else:
            select({i})
            st["anchor"] = i
            mode = "band"
        st["press"] = {"i": i, "x": e.x_root, "y": e.y_root, "mode": mode,
                       "collapse": collapse}
        return True

    def motion(w, e):
        p = st["press"]
        if not p or not p["mode"]:
            return True
        moved = w.drag_check_threshold(int(p["x"]), int(p["y"]), int(e.x_root), int(e.y_root))
        if p["mode"] == "band" and moved and not p.get("vertical"):
            # 1o movimento decide: mais pro lado = arrastar so esta linha,
            # mais pra cima/baixo = selecionar como texto
            if abs(e.x_root - p["x"]) > abs(e.y_root - p["y"]):
                p["mode"] = "drag"
            else:
                p["vertical"] = True
        if p["mode"] == "drag":
            if moved:
                begin_drag(e)
        elif not p.get("vertical"):
            pass  # ainda dentro do limiar
        elif not (x0 := ax.start(colx[st["anchor"] // rows] + 1)) <= e.x_root \
                < x0 + colw[st["anchor"] // rows] * cw:
            begin_drag(e)  # saiu da coluna dos nomes pro lado: vira arraste
        else:
            # botao segurado: o terminal nao ve o mouse, so o pixel diz a linha
            # na coluna de onde partiu, presa as linhas da tela
            r = min(max(ay.cell(int(e.y_root)) - 1 + off, off), off + height - 1)
            j = st["anchor"] // rows * rows + r
            select(span(st["anchor"], min(j, len(lines) - 1)))
        return True

    win.connect("button-press-event", press)
    win.connect("motion-notify-event", motion)

    def release(w, e):
        p, st["press"] = st["press"], None
        if st["dragging"]:
            return True
        if e.button == 1 and p and p["collapse"]:
            select({p["i"]})
            st["anchor"] = p["i"]
        elif e.button == 3 and st["i"] is not None:
            f = gfiles[st["i"]]
            info = query(st["i"], "standard::content-type")
            ctype = info and info.get_content_type()
            menu = Gtk.Menu()
            for app in Gio.AppInfo.get_all_for_type(ctype) if ctype else []:
                item = Gtk.MenuItem(label=app.get_display_name())
                item.connect("activate", lambda _, a=app: launch(a, f))
                menu.append(item)
            if not menu.get_children():
                menu.append(Gtk.MenuItem(label="(nenhum app)", sensitive=False))
            menu.show_all()
            menu.popup_at_pointer(e)
            st["menu"] = menu  # segura referencia enquanto aberto
        unhover_if_away()
        return True

    win.connect("button-release-event", release)

    def leave(w, e):
        # saiu da linha: esconde; no terminal o proximo movimento mostra a nova
        # (ignora saidas causadas por grab: inicio do arraste, menu)
        if e.mode == Gdk.CrossingMode.NORMAL:
            hover(None)

    win.connect("leave-notify-event", leave)

    def wheel(w, e):
        # com o ponteiro sobre o destaque a roda vem pra esta janela, nao pro terminal
        down = e.direction == Gdk.ScrollDirection.DOWN
        if down or e.direction == Gdk.ScrollDirection.UP:
            scroll(3 if down else -3)
        return True

    win.connect("scroll-event", wheel)

    def on_input(source, cond):
        events, keys = read_input(fd)
        if not events and not keys:
            Gtk.main_quit()  # terminal fechou (EOF): sair em vez de girar em falso
            return False
        if events:
            # roda: botao 64 sobe, 65 desce (+4/8/16 com shift/alt/ctrl)
            scroll(sum(3 if b & 1 else -3 for b, _, _ in events if b & ~28 in (64, 65)))
            # o ponteiro lido e o de agora: so o evento mais novo bate com ele
            _, col, row = events[-1]
            x, y = pointer()
            ax.feed(col, x)
            ay.feed(row, y)
            r = row - 1 + off  # celula (col, row) -> arquivo: linha da grade e coluna
            c = next((c for c, x in enumerate(colx) if x < col <= x + colw[c]), None)
            hover(None if c is None or r >= off + height else c * rows + r)
        page = max(height - 1, 1)
        for arrow, pg in NAV.findall(keys):
            scroll({b"A": -1, b"B": 1, b"H": -rows, b"F": rows,
                    b"5": -page, b"6": page}[arrow or pg])
        keys = NAV.sub(b"", keys)
        # ponytail: so o eixo y avisa; celulas de 8px no x confundem atraso com zoom
        if not st["warned"] and ay.misses >= 3:
            st["warned"] = True
            redraw()  # aviso no lugar da linha de ajuda
        if b"\x1b[O" in keys:
            # aba trocada ou janela sem foco: nenhum movimento chega para esconder;
            # num terminal visivel o proximo movimento mostra de novo
            hover(None)
        if keys == b"\x1b" and sel:
            select(())  # Esc limpa a selecao; outro Esc sai
        elif b"q" in keys or b"\x03" in keys or keys == b"\x1b":
            Gtk.main_quit()
            return False
        elif b"a" in keys:
            select(range(len(files)))
        return True

    def resize():
        # zoom tambem redimensiona: mede de novo e redesenha no tamanho novo
        st["warned"], ay.misses = False, 0
        hover(None)
        layout()
        redraw()
        return True

    GLib.io_add_watch(fd, GLib.IO_IN, on_input)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGWINCH, resize)
    # morto por sinal (kill, fechar aba): sai pelo caminho normal e restaura o terminal
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, lambda *_: Gtk.main_quit() or False)
    # tela cheia (sem historico pra rolar: o terminal nunca move a lista sem o dls
    # saber), sem cursor, sem quebra de linha (1 arquivo = 1 linha de tela)
    os.write(1, b"\x1b[?1049h\x1b[?25l\x1b[?7l")
    layout()
    redraw()
    # todo movimento do mouse, formato SGR; e aviso de foco (\e[I / \e[O)
    os.write(1, b"\x1b[?1003h\x1b[?1006h\x1b[?1004h")
    Gtk.main()


def main():
    args = sys.argv[1:]
    if subprocess.run(["ls", *args], capture_output=True).returncode:
        return subprocess.call(["ls", *args])  # mostra o erro do ls
    flags, files = parse(args)
    # saida redirecionada (dls > x, dls | less): nao ha terminal pra desenhar
    if not files or not (sys.stdin.isatty() and sys.stdout.isatty()) \
            or not os.environ.get("DISPLAY"):
        return subprocess.call(["ls", "--color=auto", *args])
    problem = missing_requirement()
    if problem:
        print(f"dls: {problem}", file=sys.stderr)
        return subprocess.call(["ls", "--color=auto", *args])

    lines = render(flags, files)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        run(files, lines, fd, one_per_line(flags))
    finally:
        try:
            os.write(1, b"\x1b[?1003l\x1b[?1006l\x1b[?1004l\x1b[?7h\x1b[?25h\x1b[?1049l")
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        except OSError:
            pass  # aba fechada: nao ha mais terminal para restaurar
        else:
            # fora da tela cheia, a lista fica no terminal: a do proprio ls
            subprocess.call(["ls", "--color=auto", *args])
    return 0


if __name__ == "__main__":
    sys.exit(main())
